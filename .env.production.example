APP_NAME=IndoorBooking
APP_ENV=production
APP_DEBUG=false
APP_URL=https://admin.sportynix.com
APP_KEY=

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=indoor_booking
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=database

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Laravel -> Reverb internal Docker connection
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http

# Reverb server bind address
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

# Browser/Vite -> public Reverb endpoint
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=admin.sportynix.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Django -> Laravel webhook authentication
DJANGO_LARAVEL_WEBHOOK_SECRET=
