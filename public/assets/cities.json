export const SRI_LANKA_DISTRICTS = Object.keys(
  SRI_LANKA_DISTRICT_CITY_MAP,
).sort((a, b) => a.localeCompare(b));

export const getSriLankaCitiesForDistrict = (
  district?: string | null,
): string[] => {
  if (!district) {
    return [];
  }

  return [...(SRI_LANKA_DISTRICT_CITY_MAP[district] || [])].sort((a, b) =>
    a.localeCompare(b),
  );
};